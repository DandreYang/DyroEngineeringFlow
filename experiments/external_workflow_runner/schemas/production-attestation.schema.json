{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dyro.example/schemas/external-workflow-runner/production-attestation-v1.json",
  "title": "Dyro Production Acceptance Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "check_id",
    "release_manifest_sha256",
    "environment_id",
    "verdict",
    "issued_at",
    "expires_at",
    "evidence",
    "assertions",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "dyro-production-attestation"
    },
    "check_id": {
      "enum": [
        "PROD-01",
        "PROD-02",
        "PROD-09"
      ]
    },
    "release_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256",
          "summary"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "^(?:https://|s3://|gs://|az://|urn:)[^?#\\s]+$",
            "maxLength": 2048
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "assertions": {
      "oneOf": [
        {
          "$ref": "#/$defs/securityAssertions"
        },
        {
          "$ref": "#/$defs/providerAssertions"
        },
        {
          "$ref": "#/$defs/quotaAssertions"
        }
      ]
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "check_id": {
            "const": "PROD-01"
          }
        },
        "required": [
          "check_id"
        ]
      },
      "then": {
        "properties": {
          "assertions": {
            "$ref": "#/$defs/securityAssertions"
          },
          "signature": {
            "properties": {
              "purpose": {
                "const": "production-security"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "check_id": {
            "const": "PROD-02"
          }
        },
        "required": [
          "check_id"
        ]
      },
      "then": {
        "properties": {
          "assertions": {
            "$ref": "#/$defs/providerAssertions"
          },
          "signature": {
            "properties": {
              "purpose": {
                "const": "production-provider"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "check_id": {
            "const": "PROD-09"
          }
        },
        "required": [
          "check_id"
        ]
      },
      "then": {
        "properties": {
          "assertions": {
            "$ref": "#/$defs/quotaAssertions"
          },
          "signature": {
            "properties": {
              "purpose": {
                "const": "production-quota"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "purpose",
        "key_id",
        "value"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "algorithm": {
          "const": "ed25519"
        },
        "purpose": {
          "enum": [
            "production-security",
            "production-provider",
            "production-quota"
          ]
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "securityAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multi_host_escape_tested",
        "tenant_boundary_tested",
        "orchestrator_policy_verified",
        "kernel_hardening_verified",
        "storage_isolation_verified",
        "network_isolation_verified",
        "high_findings_open",
        "critical_findings_open"
      ],
      "properties": {
        "multi_host_escape_tested": {
          "type": "boolean"
        },
        "tenant_boundary_tested": {
          "type": "boolean"
        },
        "orchestrator_policy_verified": {
          "type": "boolean"
        },
        "kernel_hardening_verified": {
          "type": "boolean"
        },
        "storage_isolation_verified": {
          "type": "boolean"
        },
        "network_isolation_verified": {
          "type": "boolean"
        },
        "high_findings_open": {
          "type": "integer",
          "minimum": 0
        },
        "critical_findings_open": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "providerAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_binary_pins_verified",
        "broker_only_credentials_verified",
        "credential_rotation_tested",
        "credential_revocation_tested",
        "failure_recovery_tested",
        "canary_runs",
        "high_findings_open",
        "critical_findings_open"
      ],
      "properties": {
        "provider_binary_pins_verified": {
          "type": "boolean"
        },
        "broker_only_credentials_verified": {
          "type": "boolean"
        },
        "credential_rotation_tested": {
          "type": "boolean"
        },
        "credential_revocation_tested": {
          "type": "boolean"
        },
        "failure_recovery_tested": {
          "type": "boolean"
        },
        "canary_runs": {
          "type": "integer",
          "minimum": 0
        },
        "high_findings_open": {
          "type": "integer",
          "minimum": 0
        },
        "critical_findings_open": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quotaAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_writable_mounts_declared",
        "byte_limits_enforced",
        "inode_limits_enforced",
        "file_count_limits_enforced",
        "exhaustion_tested",
        "concurrent_tenant_tested",
        "writable_mount_count",
        "high_findings_open",
        "critical_findings_open"
      ],
      "properties": {
        "all_writable_mounts_declared": {
          "type": "boolean"
        },
        "byte_limits_enforced": {
          "type": "boolean"
        },
        "inode_limits_enforced": {
          "type": "boolean"
        },
        "file_count_limits_enforced": {
          "type": "boolean"
        },
        "exhaustion_tested": {
          "type": "boolean"
        },
        "concurrent_tenant_tested": {
          "type": "boolean"
        },
        "writable_mount_count": {
          "type": "integer",
          "minimum": 0
        },
        "high_findings_open": {
          "type": "integer",
          "minimum": 0
        },
        "critical_findings_open": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

# check=skip=JSONArgsRecommended
FROM ubuntu:24.04 AS builder

ARG AUDIT_TARGET
ARG AUDIT_COMMIT
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN test "${AUDIT_TARGET}" = source -o "${AUDIT_TARGET}" = wheel -o "${AUDIT_TARGET}" = sdist \
    && test "${#AUDIT_COMMIT}" = 40 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git python3 python3-pip python3.12 python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /audit/context
COPY dist /audit/context/dist
COPY wheelhouse /audit/wheelhouse
COPY tools/audit_bridge_strace.py tools/verify_bridge_zero_effects.py /audit/harness/
COPY tests/fixtures/bridge/internal_candidate_runner.py tests/fixtures/bridge/protocol-v1.json /audit/harness/

RUN mkdir -p /audit/artifact /audit/source \
    && python3.12 -m venv /audit/venv \
    && case "${AUDIT_TARGET}" in \
        source) \
            set -- /audit/context/dist/source.tar.gz; \
            install_target=/audit/source; \
            tar -xzf "$1" -C /audit/source ;; \
        wheel) \
            set -- /audit/context/dist/dyro-*.whl; \
            [ "$#" -eq 1 ] && [ -f "$1" ]; \
            install_target="$1" ;; \
        sdist) \
            set -- /audit/context/dist/dyro-*.tar.gz; \
            [ "$#" -eq 1 ] && [ -f "$1" ]; \
            install_target="$1" ;; \
    esac \
    && install -m 0444 "$1" /audit/artifact/input \
    && artifact_sha="$(sha256sum /audit/artifact/input | cut -d ' ' -f 1)" \
    && printf '{"artifact_kind":"%s","artifact_sha256":"%s","commit":"%s"}\n' \
        "${AUDIT_TARGET}" "${artifact_sha}" "${AUDIT_COMMIT}" > /audit/artifact/metadata.json \
    && /audit/venv/bin/pip install --no-index --find-links=/audit/wheelhouse "$install_target"

FROM ubuntu:24.04 AS runtime

ARG AUDIT_TARGET
ENV DEBIAN_FRONTEND=noninteractive \
    DYRO_AUDIT_TARGET=${AUDIT_TARGET} \
    HOME=/audit/home \
    PATH=/audit/venv/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 python3.12 strace \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/sbin/groupadd --gid 10001 audit \
    && /usr/sbin/useradd --uid 10001 --gid 10001 --home-dir /audit/home --create-home audit \
    && mkdir -p /audit/run /source-checkout-sentinel \
    && chown 10001:10001 /audit/run

COPY --from=builder /audit/venv /audit/venv
COPY --from=builder /audit/harness /audit/harness
COPY --from=builder /audit/artifact /audit/artifact

WORKDIR /audit/run
USER 10001:10001

# The workflow, not this image, supplies: --network=none --read-only
# --cap-drop=ALL --cap-add=SYS_PTRACE --security-opt no-new-privileges=true,
# CPU/memory/PID limits, and a persistent evidence bind mount.  This gate is
# scoped to non-malicious candidate artifacts: same-UID hostile trace/report
# replacement is not claimed to be an adversarial supply-chain attestation.
CMD test -n "${DYRO_AUDIT_COMMIT:-}" \
    && test "${DYRO_AUDIT_DIRTY:-}" = clean \
    && artifact_sha="$(sha256sum /audit/artifact/input | cut -d ' ' -f 1)" \
    && /audit/venv/bin/python -I /audit/harness/verify_bridge_zero_effects.py \
        --mode candidate \
        --protocol-corpus /audit/harness/protocol-v1.json \
        --artifact-kind "${DYRO_AUDIT_TARGET}" \
        --artifact-file /audit/artifact/input \
        --artifact-sha256 "${artifact_sha}" \
        --artifact-metadata /audit/artifact/metadata.json \
        --commit "${DYRO_AUDIT_COMMIT}" \
        --dirty clean \
        --source-checkout /source-checkout-sentinel \
        --fixture-root /audit/run/candidate-fixture \
        --report /audit/run/candidate-report.json \
        --strace-dir /audit/run/candidate-traces \
        --reviewed-runtime-root /audit \
        --candidate-python /audit/venv/bin/python \
        --internal-candidate /audit/harness/internal_candidate_runner.py \
    && /audit/venv/bin/python -I /audit/harness/verify_bridge_zero_effects.py \
        --mode public \
        --protocol-corpus /audit/harness/protocol-v1.json \
        --artifact-kind "${DYRO_AUDIT_TARGET}" \
        --artifact-file /audit/artifact/input \
        --artifact-sha256 "${artifact_sha}" \
        --artifact-metadata /audit/artifact/metadata.json \
        --commit "${DYRO_AUDIT_COMMIT}" \
        --dirty clean \
        --source-checkout /source-checkout-sentinel \
        --fixture-root /audit/run/public-fixture \
        --report /audit/run/public-report.json \
        --strace-dir /audit/run/public-traces \
        --reviewed-runtime-root /audit \
        --bridge /audit/venv/bin/dyro-bridge
